# DongleHub device access without root.
#
# MCHOSE V9 PRO 2.4G dongle (hidraw)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="291d", ATTRS{idProduct}=="385d", TAG+="uaccess", MODE="0666"
#
# AttackShark X11 / Xenta (raw USB: battery endpoint + settings reports)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa60", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa55", TAG+="uaccess", MODE="0666"
